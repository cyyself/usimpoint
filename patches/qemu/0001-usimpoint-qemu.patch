index 4eb1d2cd..1a563713 100644
--- a/include/plugins/qemu-plugin.h
+++ b/include/plugins/qemu-plugin.h
@@ -825,6 +825,54 @@ const void *qemu_plugin_request_time_control(void);
 QEMU_PLUGIN_API
 void qemu_plugin_update_ns(const void *handle, int64_t time);
 
+/**
+ * typedef qemu_plugin_guest_region_cb_t - guest memory region callback
+ * @opaque: user data passed to qemu_plugin_walk_guest_regions()
+ * @start: first guest virtual address of the region
+ * @end: guest virtual address one past the end of the region
+ * @prot: QEMU_PLUGIN_PROT_* bits of the region as the guest mapped it
+ *
+ * Return non-zero to stop the walk.
+ */
+typedef int (*qemu_plugin_guest_region_cb_t)(void *opaque, uint64_t start,
+                                             uint64_t end, int prot);
+
+#define QEMU_PLUGIN_PROT_READ  1
+#define QEMU_PLUGIN_PROT_WRITE 2
+#define QEMU_PLUGIN_PROT_EXEC  4
+
+/**
+ * qemu_plugin_walk_guest_regions() - walk the guest's mapped memory regions
+ * @cb: callback invoked for each contiguous region with identical protection
+ * @opaque: user data passed to @cb
+ *
+ * User-mode only. The walk sees the same regions as the guest's
+ * /proc/self/maps. Returns the last non-zero callback result, 0 when the walk
+ * completed, or -1 when not supported (system mode).
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_walk_guest_regions(qemu_plugin_guest_region_cb_t cb,
+                                   void *opaque);
+
+/**
+ * typedef qemu_plugin_guest_write_cb_t - guest memory written by the emulator
+ * @guest_addr: first guest virtual address written
+ * @len: number of bytes written
+ */
+typedef void (*qemu_plugin_guest_write_cb_t)(uint64_t guest_addr, uint64_t len);
+
+/**
+ * qemu_plugin_register_guest_write_cb() - observe syscall writes to guest memory
+ * @cb: callback, or NULL to unregister
+ *
+ * User-mode only. @cb is invoked whenever the syscall emulation layer stores
+ * data into guest memory (e.g. the buffer of read(2) or the struct of
+ * fstat(2)). Combined with the syscall entry/return callbacks this gives the
+ * complete memory effect of each syscall. Returns false when unsupported.
+ */
+QEMU_PLUGIN_API
+bool qemu_plugin_register_guest_write_cb(qemu_plugin_guest_write_cb_t cb);
+
 /**
  * typedef qemu_plugin_vcpu_syscall_cb_t - vCPU syscall callback function type
  * @id: plugin id
diff --git a/linux-user/qemu.h b/linux-user/qemu.h
index a9dda4bb..03537bb1 100644
--- a/linux-user/qemu.h
+++ b/linux-user/qemu.h
@@ -346,11 +346,16 @@ void *lock_user(int type, abi_ulong guest_addr, ssize_t len, bool copy);
 /* Unlock an area of guest memory.  The first LEN bytes must be
    flushed back to guest memory. host_ptr = NULL is explicitly
    allowed and does nothing. */
+/* Set by plugins that want to observe guest memory written by syscalls */
+extern void (*qemu_user_guest_write_hook)(uint64_t guest_addr, uint64_t len);
+
 #ifndef CONFIG_DEBUG_REMAP
 static inline void unlock_user(void *host_ptr, abi_ulong guest_addr,
                                ssize_t len)
 {
-    /* no-op */
+    if (unlikely(qemu_user_guest_write_hook) && host_ptr && len > 0) {
+        qemu_user_guest_write_hook(guest_addr, len);
+    }
 }
 #else
 void unlock_user(void *host_ptr, abi_ulong guest_addr, ssize_t len);
