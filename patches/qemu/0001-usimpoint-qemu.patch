  * Virtual Memory queries - these are all NOPs for user-mode which
@@ -55,3 +57,45 @@ void qemu_plugin_update_ns(const void *handle, int64_t new_time)
 {
     qemu_log_mask(LOG_UNIMP, "user-mode can't control time");
 }
+
+/*
+ * Guest address space walk
+ */
+
+typedef struct {
+    qemu_plugin_guest_region_cb_t cb;
+    void *opaque;
+} WalkGuestRegions;
+
+static int walk_guest_region(void *opaque, vaddr start, vaddr end, int flags)
+{
+    WalkGuestRegions *w = opaque;
+    int prot = 0;
+
+    if (flags & PAGE_READ) {
+        prot |= QEMU_PLUGIN_PROT_READ;
+    }
+    /* PAGE_WRITE may be cleared while TBs exist for the page */
+    if (flags & PAGE_WRITE_ORG) {
+        prot |= QEMU_PLUGIN_PROT_WRITE;
+    }
+    if (flags & PAGE_EXEC) {
+        prot |= QEMU_PLUGIN_PROT_EXEC;
+    }
+    return w->cb(w->opaque, start, end, prot);
+}
+
+int qemu_plugin_walk_guest_regions(qemu_plugin_guest_region_cb_t cb,
+                                   void *opaque)
+{
+    WalkGuestRegions w = { .cb = cb, .opaque = opaque };
+    return walk_memory_regions(&w, walk_guest_region);
+}
+
+void (*qemu_user_guest_write_hook)(uint64_t guest_addr, uint64_t len);
+
+bool qemu_plugin_register_guest_write_cb(qemu_plugin_guest_write_cb_t cb)
+{
+    qemu_user_guest_write_hook = cb;
+    return true;
+}
